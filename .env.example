# Teaching-only Compose defaults. Keep this file on an isolated network and never expose it to the Internet.
# Replace every value before sharing a deployment; do not commit a real .env file.
MYSQL_ROOT_PASSWORD=teaching-root-password-change-me
MYSQL_PASSWORD=teaching-app-password-change-me
MQTT_SERVER_PASSWORD=teaching-server-password-change-me
MQTT_MANAGEMENT_PASSWORD=teaching-management-password-change-me
MQTT_PUBLIC_HOST=192.168.137.128
MYSQL_IMAGE=mysql:8.4
MQTT_IMAGE=ocrservice-mosquitto:teaching
APP_IMAGE=ocrservice:teaching
